#!/bin/sh
# The done gate: strict build, Ruby tests, bun unit tests, then browser E2E. Run from anywhere.
set -eu
cd "$(dirname "$0")/.."

want="$(cat .ruby-version)"
case "$(ruby -v)" in
  "ruby $want"*) ;;
  *) echo "need ruby $want, got: $(ruby -v)" >&2; exit 1 ;;
esac

ruby -Itests -e 'Dir["tests/*_test.rb"].sort.each { |f| require File.expand_path(f) }'

# The phone Menu button (assets/js/nav.js), the Publications year folds (assets/js/year-folds.js) and the Gallery
# category filter (assets/js/gallery-filter.js).
# bun's built-in runner, no extra dependency.
bun test tests/nav.test.js tests/year-folds.test.js tests/gallery-filter.test.js

# Browser E2E (Playwright, specs in e2e/): the layouts unit tests cannot see, the phone Filters button, the swipe
# strip, the no-JS fallbacks. Builds and serves the site itself on port 4010; about five seconds.
bin/e2e
