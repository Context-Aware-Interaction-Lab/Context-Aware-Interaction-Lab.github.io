#!/bin/sh
# Make the images a publication's figure or video needs, into assets/img/publications.
#
#   bin/figure page   PDF PAGE OUTDIR                    render one PDF page at 300 dpi to look at and pick a crop
#   bin/figure make   SLUG PAGE.png X Y W H [TX TY TW TH | pad]   publications/SLUG.jpg (large), SLUG-thumb.jpg (480x300, 16:10)
#   bin/figure poster SLUG IMAGE X Y W H                 publications/SLUG-poster.jpg (1280x720, 16:9) for a video
#   bin/figure photo  ALBUM N SRC.jpg                    gallery/ALBUM/NN.jpg (at most 1280 on the long side)
#                                                        and NN-thumb.jpg (within 640x480); prints the gallery.yml line
#
# Crops are in pixels of the 300 dpi page image, from its top-left corner. The thumbnail crop may differ from
# the large one (a wide figure needs a tighter thumbnail); 'pad' instead shows the whole figure centred on white
# in a 16:10 thumbnail; with neither, the large crop must itself be 16:10.
# `photo` is for event photos from a camera or phone: it turns the EXIF orientation into real rotation, converts to
# sRGB, resizes, then strips all metadata (location included) and checks. JPEG data only (judged by content, not name): export a real HEIC or PNG as JPEG first.
# Needs pdftoppm (poppler), sips (macOS) and python3. Adds nothing to the project.
#
# sips writes an EXIF segment into every JPEG it saves, so each output is stripped of APP1 (EXIF/XMP),
# APP13 (IPTC) and comments, then checked. ImageMetadataTest repeats that check over assets/img.
set -eu
cd "$(dirname "$0")/.."
IMG=assets/img
PUB=$IMG/publications

die() { echo "bin/figure: $*" >&2; exit 1; }

# Run a command quietly, but show its output if it fails (sips prints colour-space noise on success).
quiet() { out=$("$@" 2>&1) || { echo "$out" >&2; exit 1; }; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found"; }

slug_ok() { case "$1" in ''|*[!a-z0-9-]*) die "slug must be lowercase letters, digits and hyphens: '$1'" ;; esac; }

num_ok() { for n in "$@"; do case "$n" in ''|*[!0-9]*) die "crop values must be whole pixels: '$n'" ;; esac; done; }

# ratio_ok W H NUM DEN: width/height within 3% of NUM/DEN
ratio_ok() { awk -v w="$1" -v h="$2" -v n="$3" -v d="$4" 'BEGIN{r=(w/h)/(n/d); exit !(r>0.97 && r<1.03)}'; }

# crop SRC X Y W H OUT: sips takes height before width and the offset as Y then X.
# sips reads a 0 0 offset as "no offset" and silently crops the centre, so refuse it rather than emit the wrong region.
crop() {
  if [ "$2" -eq 0 ] && [ "$3" -eq 0 ]; then die "a crop starting at X=0 Y=0 would be centred by sips; start at 1 1 instead"; fi
  quiet sips -c "$5" "$4" --cropOffset "$3" "$2" "$1" --out "$6"
}

strip_and_check() {
  python3 -I - "$1" <<'PY'
import struct, sys
path = sys.argv[1]
data = open(path, "rb").read()
assert data[:2] == b"\xff\xd8", "not a JPEG: " + path
DROP = (0xE1, 0xED, 0xFE)  # APP1 EXIF/XMP, APP13 IPTC, comment
out, pos = bytearray(data[:2]), 2
while data[pos] == 0xFF and data[pos + 1] not in (0xDA, 0xD9):
    length = struct.unpack(">H", data[pos + 2:pos + 4])[0]
    if data[pos + 1] not in DROP:
        out += data[pos:pos + 2 + length]
    pos += 2 + length
out += data[pos:]
open(path, "wb").write(out)
left, pos = [], 2
while out[pos] == 0xFF and out[pos + 1] not in (0xDA, 0xD9):
    length = struct.unpack(">H", out[pos + 2:pos + 4])[0]
    if out[pos + 1] in DROP:
        left.append(hex(out[pos + 1]))
    pos += 2 + length
assert not left, "metadata left in %s: %s" % (path, left)
PY
}

report() { w=$(sips -g pixelWidth "$1" | awk '/pixelWidth/{print $2}'); h=$(sips -g pixelHeight "$1" | awk '/pixelHeight/{print $2}'); echo "$1  ${w}x${h}  $(wc -c <"$1" | tr -d ' ') bytes"; }

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  page)
    [ $# -eq 3 ] || die "usage: bin/figure page PDF PAGE OUTDIR"
    need pdftoppm
    [ -f "$1" ] || die "no such file: $1"
    num_ok "$2"
    mkdir -p "$3"
    quiet pdftoppm -r 300 -f "$2" -l "$2" -png "$1" "$3/page"
    ls "$3"/page*.png
    ;;
  make)
    [ $# -eq 6 ] || [ $# -eq 7 ] || [ $# -eq 10 ] || die "usage: bin/figure make SLUG PAGE.png X Y W H [TX TY TW TH | pad]"
    need sips; need python3
    slug=$1; src=$2; shift 2
    slug_ok "$slug"; [ -f "$src" ] || die "no such file: $src"
    pad=0
    if [ $# -eq 5 ]; then
      [ "$5" = pad ] || die "the seventh value must be 'pad' (or give all of TX TY TW TH)"
      pad=1; set -- "$1" "$2" "$3" "$4"
    fi
    num_ok "$@"
    X=$1; Y=$2; W=$3; H=$4
    if [ $# -eq 8 ]; then TX=$5; TY=$6; TW=$7; TH=$8; else TX=$X; TY=$Y; TW=$W; TH=$H; fi
    [ "$pad" = 1 ] || ratio_ok "$TW" "$TH" 16 10 || die "thumbnail crop ${TW}x${TH} is not 16:10; pass TX TY TW TH for a 16:10 region, or 'pad'"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    crop "$src" "$X" "$Y" "$W" "$H" "$tmp/large.png"
    # Shrink to at most 1600 wide, never enlarge: stretching a small crop only adds blur.
    if [ "$W" -gt 1600 ]; then
      quiet sips -Z 1600 -s format jpeg -s formatOptions 82 "$tmp/large.png" --out "$PUB/$slug.jpg"
    else
      quiet sips -s format jpeg -s formatOptions 82 "$tmp/large.png" --out "$PUB/$slug.jpg"
    fi
    crop "$src" "$TX" "$TY" "$TW" "$TH" "$tmp/thumb.png"
    if [ "$pad" = 1 ]; then
      # Show the whole figure: centre it on white, extended to 16:10 on whichever side is short.
      PW=$(awk -v w="$TW" -v h="$TH" 'BEGIN{ if (w/h > 1.6) printf "%d", w; else printf "%d", int(h*1.6+0.999) }')
      PH=$(awk -v w="$TW" -v h="$TH" 'BEGIN{ if (w/h > 1.6) printf "%d", int(w/1.6+0.999); else printf "%d", h }')
      quiet sips -p "$PH" "$PW" --padColor FFFFFF "$tmp/thumb.png" --out "$tmp/padded.png"
      mv "$tmp/padded.png" "$tmp/thumb.png"
    fi
    quiet sips -z 300 480 -s format jpeg -s formatOptions 80 "$tmp/thumb.png" --out "$PUB/$slug-thumb.jpg"
    strip_and_check "$PUB/$slug.jpg"; strip_and_check "$PUB/$slug-thumb.jpg"
    report "$PUB/$slug.jpg"; report "$PUB/$slug-thumb.jpg"
    ;;
  poster)
    [ $# -eq 6 ] || die "usage: bin/figure poster SLUG IMAGE X Y W H"
    need sips; need python3
    slug=$1; src=$2; shift 2
    slug_ok "$slug"; [ -f "$src" ] || die "no such file: $src"
    num_ok "$@"
    ratio_ok "$3" "$4" 16 9 || die "poster crop ${3}x${4} is not 16:9; the dialog would jump when the player loads"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    crop "$src" "$1" "$2" "$3" "$4" "$tmp/poster.png"
    quiet sips -z 720 1280 -s format jpeg -s formatOptions 82 "$tmp/poster.png" --out "$PUB/$slug-poster.jpg"
    strip_and_check "$PUB/$slug-poster.jpg"
    report "$PUB/$slug-poster.jpg"
    ;;
  photo)
    [ $# -eq 3 ] || die "usage: bin/figure photo ALBUM N SRC.jpg"
    need sips; need python3
    slug=$1; n=$2; src=$3
    slug_ok "$slug"; num_ok "$n"; [ -f "$src" ] || die "no such file: $src"
    # Judge the file by its first two bytes, not its extension: an iPhone export named .HEIC can hold a plain JPEG.
    [ "$(head -c 2 "$src" | od -An -tx1 | tr -d ' \n')" = "ffd8" ] || die "photo takes JPEG data, and $src is not (a real HEIC or a PNG: export it as JPEG first)"
    nn=$(printf '%02d' "$n")   # two digits at least, so an album sorts in order in Finder
    mkdir -p "$IMG/gallery/$slug"
    large="$IMG/gallery/$slug/$nn.jpg"; thumb="$IMG/gallery/$slug/$nn-thumb.jpg"
    [ ! -e "$large" ] && [ ! -e "$thumb" ] || die "gallery/$slug/$nn already exists; delete it first to redo it"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    cp "$src" "$tmp/in.jpg"
    # 1. Orientation. Cameras and phones store the pixels as the sensor saw them and write how to turn them in the EXIF
    # Orientation tag. Read it here, strip the metadata so sips cannot apply it a second time, and turn the pixels
    # ourselves; stripping alone would leave the photo sideways.
    orient=$(python3 -I - "$tmp/in.jpg" <<'PY'
import struct, sys
d = open(sys.argv[1], "rb").read()
assert d[:2] == b"\xff\xd8", "not a JPEG"
pos, value = 2, 1
while d[pos] == 0xFF and d[pos + 1] not in (0xDA, 0xD9):
    length = struct.unpack(">H", d[pos + 2:pos + 4])[0]
    body = d[pos + 4:pos + 2 + length]
    if d[pos + 1] == 0xE1 and body[:6] == b"Exif\x00\x00":
        t = body[6:]
        e = ">" if t[:2] == b"MM" else "<"
        ifd = struct.unpack(e + "I", t[4:8])[0]
        for i in range(struct.unpack(e + "H", t[ifd:ifd + 2])[0]):
            tag, typ, cnt = struct.unpack(e + "HHI", t[ifd + 2 + 12 * i:ifd + 10 + 12 * i])
            if tag == 0x0112:
                value = struct.unpack(e + "H", t[ifd + 10 + 12 * i:ifd + 12 + 12 * i])[0]
    pos += 2 + length
print(value if 1 <= value <= 8 else 1)
PY
    )
    strip_and_check "$tmp/in.jpg"
    case "$orient" in
      1) ;;
      2) quiet sips -f horizontal "$tmp/in.jpg" ;;
      3) quiet sips -r 180 "$tmp/in.jpg" ;;
      4) quiet sips -f vertical "$tmp/in.jpg" ;;
      5) quiet sips -r 90 "$tmp/in.jpg"; quiet sips -f horizontal "$tmp/in.jpg" ;;
      6) quiet sips -r 90 "$tmp/in.jpg" ;;
      7) quiet sips -r 90 "$tmp/in.jpg"; quiet sips -f vertical "$tmp/in.jpg" ;;
      8) quiet sips -r 270 "$tmp/in.jpg" ;;
      *) die "unreadable orientation '$orient'" ;;
    esac
    # 2. Colour: phones shoot in Display P3. A browser shows an untagged or sRGB file as intended, so convert; a file
    # with no profile is already read as sRGB and is left alone.
    if ! sips -g profile "$tmp/in.jpg" | grep -q '<nil>'; then
      quiet sips -m "/System/Library/ColorSync/Profiles/sRGB Profile.icc" "$tmp/in.jpg"
    fi
    # 3. Size: the long edge at most 1280 (never enlarged; a lightbox photo is never shown bigger than ~720px tall); the thumbnail fits 640x480 and keeps the aspect ratio.
    w=$(sips -g pixelWidth "$tmp/in.jpg" | awk '/pixelWidth/{print $2}'); h=$(sips -g pixelHeight "$tmp/in.jpg" | awk '/pixelHeight/{print $2}')
    if [ "$w" -gt 1280 ] || [ "$h" -gt 1280 ]; then
      quiet sips -Z 1280 -s format jpeg -s formatOptions 50 "$tmp/in.jpg" --out "$large"
    else
      quiet sips -s format jpeg -s formatOptions 50 "$tmp/in.jpg" --out "$large"
    fi
    dims=$(awk -v w="$w" -v h="$h" 'BEGIN{ s=640/w; if (480/h < s) s=480/h; if (s>1) s=1; printf "%d %d", int(h*s+0.5), int(w*s+0.5) }')
    quiet sips -z $dims -s format jpeg -s formatOptions 55 "$tmp/in.jpg" --out "$thumb"
    strip_and_check "$large"; strip_and_check "$thumb"
    report "$large"; report "$thumb"
    echo "  (EXIF orientation $orient applied; paste into gallery.yml:)"
    echo "  - {file: \"$nn\", width: $(sips -g pixelWidth "$large" | awk '/pixelWidth/{print $2}'), height: $(sips -g pixelHeight "$large" | awk '/pixelHeight/{print $2}'), alt: \"...\"}"
    ;;
  *)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
